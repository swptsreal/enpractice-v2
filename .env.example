# Backend API base URL (Spring Boot).
# VITE_API_URL is baked into the bundle at BUILD time, not read at runtime — so
# changing it requires a rebuild. This is why .env is gitignored: it is per-machine.
#
# `/api` — a RELATIVE base — is what local development wants, because the Vite dev
# server proxies /api and /ws to the backend (vite.config.js §4). An absolute
# http://localhost:8082/api breaks three ways at once: mixed content on the https dev
# page, a CORS allowlist that only names https://localhost:5173 and :5174, and the port
# drift when 5173 is taken. Use an absolute URL only for a build that talks to a
# deployed backend directly.
VITE_API_URL=/api
VITE_INTERNAL_KEY=internal-key

# Public site URL, used for canonical / og:url / absolute og:image.
VITE_SITE_URL=https://enpractice.site

# Firebase (FCM push notifications). Fill in from the Firebase console.
VITE_FIREBASE_API_KEY=firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_STORAGE_BUCKET=project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123
VITE_FIREBASE_APP_ID=app-id
VITE_FIREBASE_VAPID_KEY=vapid-key
